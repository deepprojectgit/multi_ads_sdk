# Files and directories to ignore when publishing to pub.dev
# See https://dart.dev/tools/pub/publish#what-files-are-published

# IDE files
.idea/
.vscode/
*.iml
*.ipr
*.iws

# Build files
build/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/

# Example app (keep it but don't include its build artifacts)
example/build/
example/.dart_tool/
example/.flutter-plugins
example/.flutter-plugins-dependencies
example/.packages

# Example Android: local paths and generated files (checked in but gitignored; exclude from package)
**/local.properties
**/GeneratedPluginRegistrant.java
example/android/local.properties
example/android/app/src/main/java/io/flutter/plugins/GeneratedPluginRegistrant.java

# Documentation
doc/

# Test files (optional - you might want to keep these)
# test/

# Git
.git/
.gitignore

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
